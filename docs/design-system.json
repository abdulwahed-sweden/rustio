{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "RustIO Design System",
  "version": "1.0.0",
  "description": "Design tokens for RustIO admin and scaffolded projects. Mirrors tailwind.config.js — keep both in sync.",

  "themes": {
    "light": {
      "colors": {
        "background": "#F4F6FB",
        "surface": "#FFFFFF",
        "surfaceMuted": "#F9FAFB",
        "text": "#111827",
        "textMuted": "#6B7280",
        "border": "#E5E7EB",
        "primary": "#111827",
        "accent": "#3B82F6",
        "success": "#16A34A",
        "warning": "#D97706",
        "danger": "#DC2626"
      }
    },

    "dark": {
      "colors": {
        "background": "#2B2D33",
        "layer1": "#31343A",
        "layer2": "#383B42",
        "layer3": "#40444C",
        "layer4": "#484C55",
        "surface": "#383B42",
        "surfaceMuted": "#31343A",
        "text": "#F5F5F5",
        "textMuted": "#B8B8C0",
        "border": "#4A4E57",
        "primary": "#F5F5F5",
        "accent": "#5B8CFF",
        "success": "#34D399",
        "warning": "#FBBF24",
        "danger": "#F87171"
      }
    },

    "rust": {
      "colors": {
        "background": "#FFFAF8",
        "surface": "#FFFFFF",
        "surfaceMuted": "#FFF5F1",
        "text": "#111827",
        "textMuted": "#6B7280",
        "border": "#EFE6E1",
        "primary": "#111827",
        "accent": "#C2410C",
        "success": "#16A34A",
        "warning": "#D97706",
        "danger": "#DC2626"
      }
    }
  },

  "typography": {
    "fontFamilies": {
      "sans": ["Roboto", "sans-serif"],
      "heading": ["Space Grotesk", "sans-serif"],
      "mono": ["JetBrains Mono", "monospace"]
    },
    "fontSizes": {
      "display": { "size": "40px", "lineHeight": "1.2" },
      "h1": { "size": "32px", "lineHeight": "1.3" },
      "h2": { "size": "24px", "lineHeight": "1.35" },
      "h3": { "size": "20px", "lineHeight": "1.4" },
      "body": { "size": "16px", "lineHeight": "1.6" },
      "small": { "size": "14px", "lineHeight": "1.5" },
      "caption": { "size": "12px", "lineHeight": "1.4" }
    }
  },

  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px"
  },

  "borderRadius": {
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "18px"
  },

  "boxShadow": {
    "card": "0 2px 6px rgba(0,0,0,0.08)",
    "dropdown": "0 12px 24px rgba(0,0,0,0.12)",
    "modal": "0 24px 48px rgba(0,0,0,0.18)"
  },

  "components": {
    "button": {
      "height": "40px",
      "radius": "md",
      "variants": ["primary", "secondary", "ghost", "danger"]
    },
    "input": {
      "height": "42px",
      "radius": "md"
    },
    "card": {
      "radius": "lg",
      "shadow": "card",
      "padding": "lg"
    },
    "table": {
      "rowHeight": "48px"
    }
  },

  "layout": {
    "sidebarWidth": "260px",
    "contentMaxWidth": "1440px",
    "pagePadding": "24px",
    "sectionGap": "24px"
  },

  "tailwind": {
    "colorAliases": {
      "bg": "background",
      "card": "surface",
      "muted": "surfaceMuted",
      "text": "text",
      "text-muted": "textMuted",
      "border": "border",
      "primary": "primary",
      "accent": "accent"
    }
  },

  "darkMode": {
    "strategy": "class",
    "note": "Toggled at runtime via the `dark` class on <html> or <body>."
  },

  "usage": {
    "tailwindReference": "tailwind.config.js",
    "rules": [
      "Use semantic tokens (surface, text, border, accent) — never raw hex in components.",
      "Dark theme uses layers (layer1–layer4) for stacked surfaces; pick by depth.",
      "Default admin theme is light. Activate dark via <html class=\"dark\">.",
      "Optional brand-accented theme: <html class=\"theme-brand\">. Backed by the themes.rust token block.",
      "theme-rust is a backward-compatible alias of theme-brand; new code should prefer theme-brand.",
      "Every interactive element must have a visible focus state using accent."
    ]
  }
}
