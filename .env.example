# RustIO environment configuration — example.
#
# Copy this file to `.env` for local dev:
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real secrets.

# --- Required (runtime server + CLI) ----------------------------------

# Postgres connection string. The deployed binary, the example crate,
# and every DB-touching `rustio` CLI subcommand all read this.
# CLI subcommands also accept `--db` as an explicit override.
DATABASE_URL=postgres://postgres:dev@localhost/rustio_dev

# --- Optional (runtime) -----------------------------------------------

# Meilisearch endpoint. If unreachable, search features silently
# degrade — the admin and the rest of the app keep working.
MEILI_URL=http://localhost:7700

# Meilisearch master key. Set this in production. Local Meili runs
# with `MEILI_ENV=development`, which is permissive without a key.
# MEILI_MASTER_KEY=

# Override for packaged binaries that don't ship with the source
# tree. The example crate defaults to its own migrations dir.
# MIGRATIONS_DIR=examples/blog/migrations

# Disk overrides for embedded templates. Files placed here override
# the framework's baked-in templates at request time — no restart.
# RUSTIO_TEMPLATE_DIR=templates

# --- Demo mode (dev only) ---------------------------------------------

# Setting this to "1" seeds five demo users with public passwords
# (one per role) and renders a red DEMO banner on every admin page.
# Leave UNSET in production. This is the only env switch that needs
# to flip between dev and prod.
# RUSTIO_DEMO_MODE=1

# --- AI developer tooling (optional, dev-time only) -------------------
#
# These variables are read by `rustio ai *` CLI subcommands only.
# The deployed HTTP binary has no path into the AI layer, so these
# stay unset on production servers.

# ANTHROPIC_API_KEY=
# ANTHROPIC_API_BASE=https://api.anthropic.com
# RUSTIO_AI_MODEL=
