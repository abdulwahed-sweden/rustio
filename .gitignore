# Rust build output
/target
**/target

# Editor / OS junk
*.swp
*.swo
.DS_Store
.idea/
.vscode/

# Local cookie / smoke-test scratch
/tmp/rustio.jar

# Phase 7a/2 — node_modules from the Tailwind build pipeline.
# The compiled `rustio-core/assets/static/css/admin.css` IS committed
# (so `cargo run` works without Node). `make css` regenerates it.
node_modules/
package-lock.json

# .env files for local development
.env

# Local experiments / scratch — playground/ holds untracked
# scaffolds and demo schemas that shouldn't ship.
playground/

# Claude Code runtime artifacts (lock files for scheduled tasks etc).
# `.claude/settings.local.json` is already covered by the user's global
# gitignore; this rule keeps ephemeral lock files out of the tree.
.claude/*.lock
